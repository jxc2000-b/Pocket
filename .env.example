# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# The model that routes messages, answers recall and describes photos.
# Gemini (https://aistudio.google.com/apikey) is used when GEMINI_API_KEY is set.
GEMINI_API_KEY=
# Optional: Gemini model id. Defaults to gemini-flash-lite-latest.
GEMINI_MODEL=
# Optional: tried when the main model is overloaded or too slow. Defaults to gemini-flash-latest.
GEMINI_FALLBACK_MODEL=
# Optional alternative: Claude (https://console.anthropic.com), used when only
# this key is set or when POCKET_LLM=claude.
ANTHROPIC_API_KEY=
# Optional: force "gemini" or "claude".
POCKET_LLM=

# Absolute path to the Obsidian vault folder Pocket writes notes into.
POCKET_VAULT_PATH=

# Optional: IANA time zone for dates ("America/Los_Angeles"). Defaults to the Mac's zone.
POCKET_TIMEZONE=

# ElevenLabs (https://elevenlabs.io): Scribe speech-to-text and text-to-speech.
ELEVENLABS_API_KEY=
# Pocket's voice. Leave empty for the default premade voice.
ELEVENLABS_VOICE_ID=
# Optional model overrides (defaults: scribe_v1, eleven_multilingual_v2).
ELEVENLABS_STT_MODEL=
ELEVENLABS_TTS_MODEL=

# Apple Shortcuts Pocket may run (exact names, comma-separated). Empty = all five
# built-in names (Pocket Calendar Event, Pocket Reminder, Pocket Note,
# Pocket Bedtime, Pocket Focus). "none" disables Shortcuts.
POCKET_SHORTCUTS_ALLOWLIST=

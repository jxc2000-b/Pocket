# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Claude (https://console.anthropic.com). Used for routing, recall and photos.
ANTHROPIC_API_KEY=

# Absolute path to the Obsidian vault folder Pocket writes notes into.
POCKET_VAULT_PATH=

# Optional: IANA time zone for dates ("America/Los_Angeles"). Defaults to the Mac's zone.
POCKET_TIMEZONE=
